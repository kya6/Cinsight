# Copy to backend/.env for local overrides. Every value is optional.
# Load it with:  uvicorn app.main:app --reload --env-file .env

# Folder with the notebook's exported files. Default: the repo's artifacts/ folder.
# ARTIFACTS_DIR=../artifacts

# Extra browser origins allowed to call the API, comma-separated. Always allowed:
# http://localhost:3000, https://cinsight.moxs.space and https://*.vercel.app preview deployments.
# FRONTEND_ORIGINS=https://another-domain.example

# Batch upload limits and the High-risk queue export cap
MAX_UPLOAD_MB=10
MAX_BATCH_ROWS=20000
EXPORT_MAX_ROWS=20000
